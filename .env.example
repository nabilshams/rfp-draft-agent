# ─── Required ───────────────────────────────────────────
# Azure AI Foundry
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o

# Azure AI Search
AZURE_AI_SEARCH_CONNECTION_NAME=my-search-connection
AI_SEARCH_INDEX_NAME=rfp-knowledge-base

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_URL=https://<storageaccount>.blob.core.windows.net
STORAGE_KB_CONTAINER=knowledge-base
STORAGE_RFP_CONTAINER=rfp-uploads
STORAGE_OUTPUT_CONTAINER=outputs

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;...

# Authentication
#   disabled – no authentication (local development only; logs a warning at startup)
#   easyauth – Azure Container Apps built-in authentication (set by azd; see README)
#   jwt      – the app validates Entra ID bearer tokens; requires the three ENTRA_* values below
AUTH_MODE=disabled
# ENTRA_TENANT_ID=<your-tenant-id>
# ENTRA_CLIENT_ID=<your-client-id>
# ENTRA_AUDIENCE=api://<your-client-id>

# ─── Optional ──────────────────────────────────────────
# RUN_TIMEOUT_SECONDS=600
# EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-large
# FOUNDRY_AGENTS_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>   (helper scripts only)
# BING_CONNECTION_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>/connections/<bing-connection>
# FOUNDRY_PROJECT_NAME=<project-name>
# PARALLELISM=4
# SECTION_PARALLELISM=3
# LOG_LEVEL=INFO
