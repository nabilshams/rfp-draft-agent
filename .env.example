# ─── Required ───────────────────────────────────────────
# Azure AI Foundry
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o

# Azure AI Search
AZURE_AI_SEARCH_CONNECTION_NAME=my-search-connection
AI_SEARCH_INDEX_NAME=rfp-knowledge-base

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_URL=https://<storageaccount>.blob.core.windows.net
STORAGE_KB_CONTAINER=knowledge-base
STORAGE_RFP_CONTAINER=rfp-uploads
STORAGE_OUTPUT_CONTAINER=outputs
# STORAGE_JOBS_CONTAINER=draft-jobs

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;...

# Authentication
#   disabled – no authentication (local development only; logs a warning at startup)
#   easyauth – Azure Container Apps built-in authentication (set by azd; see README)
#   jwt      – the app validates Entra ID bearer tokens; requires the three ENTRA_* values below
AUTH_MODE=disabled
# ENTRA_TENANT_ID=<your-tenant-id>
# ENTRA_CLIENT_ID=<your-client-id>
# ENTRA_AUDIENCE=api://<your-client-id>

# ─── Optional ──────────────────────────────────────────
# RUN_TIMEOUT_SECONDS=600
# JOB_WORKERS=2                  # background drafts (POST /drafts) running at once in this process
# JOB_MAX_ACTIVE_PER_USER=3
# JOB_HEARTBEAT_SECONDS=15       # a running job records that it is alive this often...
# JOB_STALE_SECONDS=120          # ...and is reported as interrupted after this long without it
# SEARCH_TOP_K=5                 # knowledge-base documents retrieved per requirement
# SEARCH_MIN_SCORE=0             # drop weaker matches (reranker score 0-4 with the semantic ranker, else search score)
# SEARCH_SEMANTIC_RANKER=false   # re-rank with Azure AI Search's semantic ranker (metered; Basic tier or above)
# SEARCH_MAX_CONTEXT_DOCS=15     # cap on documents shared by many requirements (full draft, section narratives)
# ADMIN_OIDS=<object-id>,<object-id>   # users who can manage everything (az ad signed-in-user show --query id -o tsv)
# MAX_UPLOAD_MB=25
# RATE_LIMIT_PER_MINUTE=60
# EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-large
# FOUNDRY_AGENTS_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>   (helper scripts only)
# BING_CONNECTION_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>/connections/<bing-connection>   # enables the per-request web-search opt-in; queries leave the Azure compliance boundary
# REDACTION_CUSTOMER_NAMES=Contoso Ltd;Fabrikam   # semicolon-separated customer names to redact (keep out of version control)
# FOUNDRY_PROJECT_NAME=<project-name>
# PARALLELISM=4
# SECTION_PARALLELISM=3
# LOG_LEVEL=INFO
