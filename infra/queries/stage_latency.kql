// Where time and money go, by stage, over the last week: model calls, retrieval, section writing and storing outputs.
AppDependencies
| where TimeGenerated > ago(7d) and Name in ("llm.run", "kb.search", "section.classify", "section.narrative", "outputs")
| extend p = Properties
| summarize
    count = count(),
    p50_ms = percentile(DurationMs, 50),
    p95_ms = percentile(DurationMs, 95),
    failed = countif(tostring(p["outcome"]) in ("failed", "error")),
    input_tokens = sum(tolong(p["llm.input_tokens"])),
    output_tokens = sum(tolong(p["llm.output_tokens"])),
    cost_usd = sum(todouble(p["llm.cost_usd"]))
    by stage = Name, model = tostring(p["llm.model"])
| order by cost_usd desc, p95_ms desc
